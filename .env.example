# Copy to .env (never commit it) or set these in your host's secret store.

# production | development. Production refuses a weak SECRET_KEY, dev sign-in, and missing GitHub OAuth.
AGENTSEC_ENV=production
# postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# 32+ random characters; signs session cookies. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# The URL people open, without a trailing slash. Upload responses link here.
PUBLIC_URL=https://dashboard.example.com
# GitHub OAuth app (Settings > Developer settings > OAuth Apps). Callback URL: $PUBLIC_URL/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional
# SECURE_COOKIES=true          # default true in production
# SESSION_DAYS=14
# AGENTSEC_DEV_LOGIN=0         # development only: sign in with any username, no GitHub

# Free plan limits (app/plans.py)
# FREE_MAX_PROJECTS=10
# FREE_MAX_REPORTS_PER_PROJECT=500
# FREE_RETENTION_DAYS=90
# FREE_MAX_REPORT_MB=25
# FREE_MAX_TOKENS_PER_PROJECT=10
